<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scenary.user.UserMapper">

    <sql id="all_columns">
        id, username, password_hash, nickname, avatar_url, bio, status, created_at, updated_at
    </sql>

    <sql id="base_columns">
        username, password_hash, nickname, avatar_url, bio, status
    </sql>

    <insert id="insert" parameterType="com.scenary.user.UserEntity"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO users (<include refid="base_columns"/>)
        VALUES (#{username}, #{passwordHash}, #{nickname}, #{avatarUrl}, #{bio}, #{status})
    </insert>

    <select id="findByUsername" resultType="com.scenary.user.UserEntity">
        SELECT <include refid="all_columns"/>
        FROM users
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="findById" resultType="com.scenary.user.UserEntity">
        SELECT <include refid="all_columns"/>
        FROM users
        WHERE id = #{id}
        LIMIT 1
    </select>

    <update id="updateProfile">
        UPDATE users
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="bio != null">bio = #{bio},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateAvatar">
        UPDATE users SET avatar_url = #{avatarUrl} WHERE id = #{id}
    </update>

</mapper>
