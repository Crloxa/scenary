# Scenary 开发/部署环境模板 · 复制为 .env 并填入真实值
# 规约：.env 及一切真实密钥严禁入库；密钥一律 openssl rand -hex 生成（见 docs/03 Phase 0）

MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE
MYSQL_DATABASE=scenary
MYSQL_USER=scenary
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

REDIS_ARGS=--appendonly no

RABBITMQ_DEFAULT_USER=scenary_mq
RABBITMQ_DEFAULT_PASS=YOUR_RABBITMQ_PASSWORD_HERE

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=YOUR_MINIO_PASSWORD_HERE
MINIO_BUCKET=scenary-media

JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=2592000

# P10 基础评论拦截与实时通知；词表只用于基础拦截，完整审核仍属 P13
SCENARY_COMMENT_SENSITIVE_WORDS=诈骗,赌博,色情
SCENARY_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 浏览器访问地址（冒烟脚本与图片反代用）；服务器部署改为公网IP/域名
PUBLIC_HOST=localhost
